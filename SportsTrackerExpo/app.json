{
  "expo": {
    "name": "SportsHeart",
    "slug": "sportsheart",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "runtimeVersion": "1.3.0",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sportsheart.app",
      "buildNumber": "9",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.sportsheart.app",
      "versionCode": 15,
      "googleServicesFile": "./google-services.json",
      "permissions": ["INTERNET", "VIBRATE"],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "nixa-expo-dynamic-app-icon",
        {
          "dark_blue": {
            "image": "./assets/dark/blue.png",
            "prerendered": true,
            "platforms": ["ios", "android"]
          },
          "dark_red": {
            "image": "./assets/dark/red.png",
            "prerendered": true,
            "platforms": ["ios", "android"]
          },
          "dark_green": {
            "image": "./assets/dark/green.png",
            "prerendered": true,
            "platforms": ["ios", "android"]
          },
          "dark_purple": {
            "image": "./assets/dark/purple.png",
            "prerendered": true,
            "platforms": ["ios", "android"]
          },
          "dark_gold": {
            "image": "./assets/dark/gold.png",
            "prerendered": true,
            "platforms": ["ios", "android"]
          },
          "dark_custom": {
            "image": "./assets/dark/custom.png",
            "prerendered": true,
            "platforms": ["ios", "android"]
          },
          "light_blue": {
            "image": "./assets/light/blue.png",
            "prerendered": true,
            "platforms": ["ios", "android"]
          },
          "light_red": {
            "image": "./assets/light/red.png",
            "prerendered": true,
            "platforms": ["ios", "android"]
          },
          "light_green": {
            "image": "./assets/light/green.png",
            "prerendered": true,
            "platforms": ["ios", "android"]
          },
          "light_purple": {
            "image": "./assets/light/purple.png",
            "prerendered": true,
            "platforms": ["ios", "android"]
          },
          "light_gold": {
            "image": "./assets/light/gold.png",
            "prerendered": true,
            "platforms": ["ios", "android"]
          },
          "light_custom": {
            "image": "./assets/light/custom.png",
            "prerendered": true,
            "platforms": ["ios", "android"]
          }
        }
      ],
      "@react-native-firebase/app",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "newArchEnabled": false
          },
          "android": {
            "newArchEnabled": false,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "blockedPermissions": [
              "android.permission.READ_MEDIA_IMAGES",
              "android.permission.READ_MEDIA_VIDEO"
            ]
          }
        }
      ],
      "expo-notifications",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.sportsheart.app.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.sportsheart.app",
          "enablePushNotifications": true,
          "widgets": [
            {
              "name": "FootballLiveActivity",
              "displayName": "Football Live",
              "description": "Live football match activity",
              "supportedFamilies": [
                "accessoryRectangular",
                "accessoryInline",
                "systemMedium",
                "systemLarge"
              ]
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "buildReactNativeFromSource": true
          }
        }
      ],
      "expo-image",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "fb066229-1442-4efb-b65c-4588b95b115c"
      },
      "enableAnalyticsInDev": true
    },
    "updates": {
      "url": "https://u.expo.dev/fb066229-1442-4efb-b65c-4588b95b115c",
      "fallbackToCacheTimeout": 30000,
      "checkAutomatically": "ON_LOAD"
    },
    "owner": "laraiyeo"
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-5256386471137141~8370359232",
    "ios_app_id": "ca-app-pub-5256386471137141~8370359232"
  }
}
