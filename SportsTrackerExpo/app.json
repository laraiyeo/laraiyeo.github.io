{
  "expo": {
    "name": "SportsHeart",
    "slug": "sportsheart",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": "1.1.0",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sportsheart.app",
      "buildNumber": "6",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.sportsheart.app",
      "versionCode": 12,
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "permissions": ["INTERNET", "VIBRATE"],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "nixa-expo-dynamic-app-icon",
        {
          "dark_blue": {
            "image": "./assets/dark/blue.png",
            "prerendered": true,
            "platforms": ["ios", "android"]
          },
          "dark_red": {
            "image": "./assets/dark/red.png",
            "prerendered": true,
            "platforms": ["ios", "android"]
          },
          "dark_green": {
            "image": "./assets/dark/green.png",
            "prerendered": true,
            "platforms": ["ios", "android"]
          },
          "dark_purple": {
            "image": "./assets/dark/purple.png",
            "prerendered": true,
            "platforms": ["ios", "android"]
          },
          "dark_gold": {
            "image": "./assets/dark/gold.png",
            "prerendered": true,
            "platforms": ["ios", "android"]
          },
          "light_blue": {
            "image": "./assets/light/blue.png",
            "prerendered": true,
            "platforms": ["ios", "android"]
          },
          "light_red": {
            "image": "./assets/light/red.png",
            "prerendered": true,
            "platforms": ["ios", "android"]
          },
          "light_green": {
            "image": "./assets/light/green.png",
            "prerendered": true,
            "platforms": ["ios", "android"]
          },
          "light_purple": {
            "image": "./assets/light/purple.png",
            "prerendered": true,
            "platforms": ["ios", "android"]
          },
          "light_gold": {
            "image": "./assets/light/gold.png",
            "prerendered": true,
            "platforms": ["ios", "android"]
          }
        }
      ],
      "@react-native-firebase/app",
      "./plugins/withSimpleFirebase.js",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "newArchEnabled": true,
            "xcodeProjectSettings": {
              "CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES": "YES",
              "CLANG_WARN_NON_MODULAR_INCLUDE_IN_FRAMEWORK_MODULE": "NO",
              "GCC_TREAT_WARNINGS_AS_ERRORS": "NO",
              "OTHER_CFLAGS": "$(inherited) -Wno-error -Wno-non-modular-include-in-framework-module"
            }
          },
          "android": {
            "newArchEnabled": true,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "blockedPermissions": [
              "android.permission.READ_MEDIA_IMAGES",
              "android.permission.READ_MEDIA_VIDEO"
            ]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fb066229-1442-4efb-b65c-4588b95b115c"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/fb066229-1442-4efb-b65c-4588b95b115c",
      "fallbackToCacheTimeout": 30000,
      "checkAutomatically": "ON_LOAD"
    },
    "owner": "laraiyeo"
  }
}
